<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>CleanMessageBus.Abstractions</PackageId>
        <Company>Zwergenland27</Company>
        <Authors>Florian Königsmann</Authors>
        <Product>CleanMessageBus</Product>
        <Description>Abstraction of message brokers for easy integration of events</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Zwergenland27/CleanMessageBus.Abstractions</RepositoryUrl>
        <PackageTags>Events; Messaging; DDD</PackageTags>
        <PackageProjectUrl>https://github.com/Zwergenland27/CleanMessageBus.Abstractions/</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
      <PackageReference Include="Zwergenland.CleanDomainValidation" Version="1.1.1" />
    </ItemGroup>

</Project>
