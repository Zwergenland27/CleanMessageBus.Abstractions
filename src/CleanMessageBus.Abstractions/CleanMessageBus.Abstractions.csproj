<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Zwergenland.CleanMessageBus.Abstractions</PackageId>
    <Title>CleanMessageBus.Abstractions</Title>
    <Company>Zwergenland</Company>
    <Authors>Florian Königsmann</Authors>
    <Product>CleanMessageBus</Product>
    <Description>Abstraction necessary for the usage of CleanMessageBus extensions</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Zwergenland27/CleanMessageBus.Abstractions</RepositoryUrl>
    <PackageTags>Events; Messaging</PackageTags>
    <PackageProjectUrl>https://github.com/Zwergenland27/CleanMessageBus.Abstractions</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
